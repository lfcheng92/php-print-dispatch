#!/usr/bin/env php
<?php
declare(strict_types=1);

// Composer's bin proxy supplies this variable when installed in another project.
$autoload = $GLOBALS['_composer_autoload_path'] ?? __DIR__ . '/../vendor/autoload.php';
if (!is_string($autoload) || !is_file($autoload)) {
    fwrite(STDERR, "Composer autoload missing. Run composer install first.\n");
    exit(1);
}
require $autoload;
// Read this scope: Composer proxies include the entry point, and callers can replace argv.
$input = get_defined_vars()['argv'] ?? null;
$arguments = is_array($input) ? array_values(array_filter($input, 'is_string')) : [];
// PHP 8.5 CLI supplies argv even when register_argc_argv=0. Check the actual input.
if ($arguments === [] || $arguments !== $input) {
    fwrite(STDERR, "CLI arguments unavailable or invalid.\n");
    exit(1);
}
exit(\Lfcheng\PrintDispatch\Console::run($arguments));
